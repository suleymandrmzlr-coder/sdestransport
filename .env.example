NODE_ENV=production
APP_ORIGIN=https://sdestransport.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_HOSTINGER_DATABASE
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove SETUP_TOKEN after creating the first administrator at /cms.
SETUP_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# Hostinger supplies PORT automatically. Do not override it in hPanel.
