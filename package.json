{
  "name": "sdes-hostinger-cms",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node server/check.mjs",
    "db:install": "node server/install.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "admin:reset": "node server/reset-password.mjs",
    "setup:token": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cheerio": "^1.1.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  }
}
